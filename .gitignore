# Env files — never commit real secrets
**/.env
**/.env.local
**/.env.*.local

# JWT keys
backend/config/jwt/

.idea/*

#FE:
/frontend/node_modules/
frontend/dist/

#BE:
# Email spool folder
/backend/app/spool/*

# Cache, session files and logs (Symfony3)
/backend/var/cache/*
/backend/var/logs/*
/backend/var/sessions/*
!/backend/var/cache/.gitkeep
!/backend/var/logs/.gitkeep
!/backend/var/sessions/.gitkeep

# Logs (Symfony4)
/backend/var/log/*
!/backend/var/log/.gitkeep

# Parameters
/backend/app/config/parameters.yml
/backend/app/config/parameters.ini

# Managed by Composer
/backend/app/bootstrap.php.cache
/backend/var/bootstrap.php.cache
/backend/bin/*
!/backend/bin/console
!/backend/bin/symfony_requirements
/backend/vendor/

# Assets and user uploads
/backend/web/bundles/
/backend/web/uploads/

# PHPUnit
/backend/app/phpunit.xml
/backend/phpunit.xml

# Build data
/backend/build/

# Composer PHAR
/backend/composer.phar

# Backup entities generated with doctrine:generate:entities command
/backend/**/Entity/*~

/backend/docker-compose.override.yml
/frontend/docker-compose.override.yml

# Embedded web-server pid file
/backend/.web-server-pid
