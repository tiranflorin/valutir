###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test_secret_for_ci_only
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

DB_PASSWORD=admin
APP_DEBUG=1
BE_PORT=8080
DB_PORT=5432

PHP_IDE_CONFIG=serverName=valutir-backend

###> lexik/jwt-authentication-bundle ###
