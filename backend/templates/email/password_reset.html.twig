{% extends 'email/layout.html.twig' %}
{% import 'email/layout.html.twig' as ui %}

{% block preheader %}Reset your ValuTir password. The link works for one hour.{% endblock %}

{% block content %}
    <h1>Reset your password</h1>
    <p>We got a request to reset the password for your ValuTir account. Choose a new one with the button below.</p>
    {{ ui.button(reset_url, 'Choose a new password') }}
    <p>The link works for one hour and only once. Resetting your password signs you out on every device.</p>
{% endblock %}

{% block note %}Didn't ask for this? Ignore this email. Your password stays the same.{% endblock %}
